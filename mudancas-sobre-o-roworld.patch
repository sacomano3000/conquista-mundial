-def hsv_scale(c, k):
-    import colorsys
-    h, s, v = colorsys.rgb_to_hsv(*(x / 255 for x in c))
-    r, g, b = colorsys.hsv_to_rgb(h, s, v * k)
-    return (round(r * 255), round(g * 255), round(b * 255))
