-# Map/MapSurface.luau terrain colours
-OCEAN = (0x47, 0x85, 0xB5)
-SAND = (0xCC, 0xCB, 0x9E)
-PLAINS = (0xBE, 0xDC, 0x8A)
-HIGHLAND = (0xDC, 0xCB, 0x9E)
