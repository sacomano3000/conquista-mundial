-def window(sc):
-    tb = load(sc["map"])
-    x, y = sc["at"]
-    win = tb[y - 1:y + CELL_H + 1, x - 1:x + CELL_W + 1]
-    if win.shape != (CELL_H + 2, CELL_W + 2):
-        sys.exit(f"{sc['map']} window {sc['at']} off the map")
-    if sc["flip"]:
-        win = win[:, ::-1]
-    return win
