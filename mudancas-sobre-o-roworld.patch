+--- A number with its sign: "+34", "−10" (a real minus sign), "0".
+function GameOver.signed(n: number): string
+	if n > 0 then
+		return "+" .. UICtx.commas(n)
+	elseif n < 0 then
+		return "−" .. UICtx.commas(-n)
+	end
+	return "0"
+end
+
+--- The two lines of a ranked match's points (`r`: Session.clean_ranked_award), as (main, detail,
+--- colour): "RANQUEADA  +34  ·  Cavaleiro  176 / 300" with "Subiu para Barão!" in place of the
+--- standing when the rank changed, and "Entrada −10  ·  Posição +23  ·  Vitória +17  ·  Reinos +8".
+function GameOver.ranked_lines(r: any): (string, string, any)
+	local Ranked = UICtx.data("Ranked")
+	local tier = Ranked.TIERS[r.tier] or Ranked.TIERS[1]
+	local nxt = Ranked.TIERS[r.tier + 1]
+	local standing
+	if r.tier > r.before then
+		standing = UITheme.tr("Promoted to") .. " " .. tier.name .. "!"
+	elseif r.tier < r.before then
+		standing = UITheme.tr("Dropped to") .. " " .. tier.name
+	elseif nxt ~= nil then
+		standing = string.format("%s  %s / %s", tier.name, UICtx.commas(r.points), UICtx.commas(nxt.at))
+	else
+		standing = string.format("%s  %s", tier.name, UICtx.commas(r.points))
+	end
+	local main = string.format("%s  %s  ·  %s", UITheme.tr("RANKED"), GameOver.signed(r.delta), standing)
+	local parts = {}
+	for _, l in r.lines do
+		table.insert(parts, UITheme.tr(Ranked.LABELS[l[1]] or l[1]) .. " " .. GameOver.signed(l[2]))
+	end
+	local color = if r.delta > 0 then UITheme.GREEN elseif r.delta < 0 then UITheme.RED else UITheme.TEXT
+	return main, table.concat(parts, "  ·  "), color
+end
+
+--- The line about the day's missions, from Data/Missions.view (`v`); "" with none to show.
