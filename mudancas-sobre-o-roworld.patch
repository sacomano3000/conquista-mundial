-# Map/MapSurface terrain colours
-OCEAN = (0x47, 0x85, 0xB5)
-SAND = (0xCC, 0xCB, 0x9E)
-PLAINS = (0xBE, 0xDC, 0x8A)
-HIGHLAND = (0xDC, 0xCB, 0x9E)
-MOUNTAIN = (0xE6, 0xE6, 0xE6)
-BACKGROUND = (0x3C, 0x3C, 0x3C)
-ALPHA = 150 / 255
-SATURATION = 0.85
-BORDER_DARKEN = 0.125
