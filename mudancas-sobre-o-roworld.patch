+        "beam": fx_beam(), "bomb": fx_bomb(), "chute": fx_chute(), "explosion": fx_explosion(),
+        "glow": fx_glow(), "mushroom": fx_mushroom(), "reticle": fx_reticle(), "ring": fx_ring(),
+        "scorch": fx_scorch(), "smoke": fx_smoke(), "spark": fx_spark(), "tracer": fx_tracer(),
