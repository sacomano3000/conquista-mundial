--- rw/tests/caixa_repetido.luau	1970-01-01 00:00:00.000000000 +0000
+++ cm/tests/caixa_repetido.luau	2026-11-12 11:51:14.779617017 +0000
@@ -0,0 +1,91 @@
+--!nocheck
+-- A crate's answer on its way from the server to the screen (2026-11-12: a crate may give an item the
+-- player has, which pays Coroas instead; Data/MyShop.caixa.repetidos):
+--   * client/Session: CRATE_RESULT carries (ok, item, Coroas of a duplicate); the third value reaches
+--     the `crate_result` signal as a whole number, 0 for a new item, and junk from the server is 0;
+--   * the same message with no third value (an older server) still works: a new item;
+--   * a refusal passes its reason and no Coroas;
+--   * the shipped numbers of Data/MyShop are the ones the game uses.
+-- What the server does with a duplicate is in tests/colecao.luau; the draw itself in tests/cosmetics.luau;
+-- the two screens in tests/telas.luau.   lune run tests/caixa_repetido.luau
+local H = require("./ui_harness")
+local Session = require("../src/client/Session")
+local Protocol = require("../src/shared/Net/Protocol")
+local Cosmetics = require("../src/shared/Data/Cosmetics")
+local MyShop = require("../src/shared/Data/MyShop")
+
+local checks, failed = 0, 0
+local function check(ok: boolean, what: string)
+	checks += 1
+	if not ok then
+		failed += 1
+		print("FAIL: " .. what)
+	end
+end
+
+H.fake_game()
+local OP = Protocol.OP
+local sent = {}
+local s = Session.new({
+	now = function()
+		return 0
+	end,
+	net = {
+		connected = true,
+		send = function(op, ...)
+			table.insert(sent, table.pack(op, ...))
+		end,
+		listen = function() end,
+	},
+})
+local got = {}
+s.crate_result:Connect(function(ok, res, back)
+	table.insert(got, { ok, res, back })
+end)
+
+check(OP.CRATE_RESULT == 33 and OP.OPEN_CRATE == 13, "the crate's two messages keep their numbers")
+s:_on_net(OP.CRATE_RESULT, true, "pet_lobo", 6000)
+check(#got == 1 and got[1][1] == true and got[1][2] == "pet_lobo" and got[1][3] == 6000, "a duplicate: the item and its 6.000 Coroas reach the screen")
+s:_on_net(OP.CRATE_RESULT, true, "pet_gato", 0)
+check(#got == 2 and got[2][2] == "pet_gato" and got[2][3] == 0, "a new item: no Coroas")
+s:_on_net(OP.CRATE_RESULT, true, "pet_gato")
+check(#got == 3 and got[3][1] == true and got[3][3] == 0, "no third value at all: a new item")
+s:_on_net(OP.CRATE_RESULT, false, "everything owned", nil)
+check(#got == 4 and got[4][1] == false and got[4][2] == "everything owned" and got[4][3] == 0, "a refusal: its reason, no Coroas")
+for _, junk in { "6000", -5, 0 / 0, {}, true } do
+	local n = #got
+	s:_on_net(OP.CRATE_RESULT, true, "pet_lobo", junk)
+	check(#got == n + 1 and got[#got][3] == 0, "junk as the Coroas (" .. tostring(junk) .. ") is no Coroas")
+end
+s:_on_net(OP.CRATE_RESULT, true, "pet_lobo", 2500.9)
+check(got[#got][3] == 2500, "a fraction is cut to a whole number")
+
+-- asking: the tab's kind goes with the request
+check(type(s.open_crate) == "function", "the session can ask to open a crate")
+local n0 = #sent
+s:open_crate("flag")
+check(#sent == n0 + 1 and sent[#sent][1] == OP.OPEN_CRATE and sent[#sent][2] == "flag", "opening a crate asks the server, with the tab's kind")
+
+-- the owner's numbers
+local cx = MyShop.caixa
+check(cx.repetidos == true, "Data/MyShop: repetidos = true")
+check(Cosmetics.DUPLICATES == true, "... and the game follows it")
+local pt = { common = "comum", rare = "raro", epic = "epico", legendary = "lendario" }
+local same, below = true, true
+for id, key in pt do
+	same = same and Cosmetics.DUPLICATE_STARS[id] == cx.coroas_repetido[key]
+	below = below and cx.coroas_repetido[key] <= cx.coroas
+end
+check(same, "the four amounts of coroas_repetido are the ones the game pays")
+check(below, "none is above a crate's price in Coroas")
+local avg = 0
+for _, r in Cosmetics.RARITIES do
+	avg += r.odds * Cosmetics.DUPLICATE_STARS[r.id]
+end
+check(math.abs(avg - 3565) < 0.5, string.format("with everything a duplicate, a crate pays back %.0f Coroas on average", avg))
+check(avg < cx.coroas * 0.25, "... under a quarter of what a crate costs")
+
+print(string.format("caixa_repetido: %d checks, %d failed", checks, failed))
+if failed > 0 then
+	error("caixa_repetido: failed")
+end
diff -ruN '--exclude=.git' '--exclude=*.rbxl' '--exclude=mudancas-sobre-o-roworld.patch' '--exclude=GUIA.md' '--exclude=SONS.md' '--exclude=out' '--exclude=build' '--exclude=.DS_Store' '--exclude=ArsenalIcon_*.luau' '--exclude=OwnArtData.luau' '--exclude=World.luau' '--exclude=EarthWorld.luau' '--exclude=MapData' '--exclude=*.png' '--exclude=*.svg' '--exclude=*.glb' '--exclude=__pycache__' '--exclude=telas' rw/tests/cobertura_inicial.luau cm/tests/cobertura_inicial.luau
--- rw/tests/cobertura_inicial.luau	1970-01-01 00:00:00.000000000 +0000
+++ cm/tests/cobertura_inicial.luau	2026-11-12 11:51:14.779617017 +0000
@@ -0,0 +1,87 @@
+--!nocheck
+-- The lobby's picture covers the screen from the client's first moment (2026-11-12: "the map shows
+-- instead of the lobby's image, and then the lobby's image loads"). client/Main brings the map up
+-- before the interface, which may wait for its fonts: UI/BootCover goes up before the map and leaves
+-- when the interface has the screen.
+--   lune run tests/cobertura_inicial.luau
+local fs = require("@lune/fs")
+local H = require("./ui_harness")
+local BootCover = require("../src/client/UI/BootCover")
+-- (the title screen's modules load as outside Roblox first, then get a stand-in for `game`)
+local _UICtx = require("../src/client/UI/UICtx")
+local _UITheme = require("../src/client/UI/UITheme")
+H.root(1280, 720, false)
+H.fake_game()
+local TitleScreen = require("../src/client/UI/TitleScreen")
+
+local checks, failed = 0, 0
+local function check(ok: boolean, what: string)
+	checks += 1
+	if not ok then
+		failed += 1
+		print("FAIL: " .. what)
+	end
+end
+
+local pg = H.new("ScreenGui")
+check(not BootCover.up(), "no cover before it is asked for")
+local sg = BootCover.show(pg)
+check(BootCover.up() and sg.Parent == pg, "the cover is on screen once shown")
+check(sg.ClassName == "ScreenGui" and sg.IgnoreGuiInset == true and sg.ResetOnSpawn == false, "it fills the screen and outlives a respawn")
+-- the map's three layers are MAP_DISPLAY_ORDER and the two above it; the interface is at 10
+local map_order = tonumber(string.match(fs.readFile("src/client/Map/MapView.luau"), "MapView%.MAP_DISPLAY_ORDER = (%-?%d+)"))
+check(map_order ~= nil and sg.DisplayOrder > map_order + 2, "the cover is above the map's three layers (" .. tostring(map_order) .. " and the two above)")
+local ui_src = fs.readFile("src/client/UI/UIRoot.luau")
+local ui_order = tonumber(string.match(ui_src, 'sg%.Name = "ConquistaUI".-sg%.DisplayOrder = (%-?%d+)'))
+check(ui_order ~= nil and sg.DisplayOrder < ui_order, "... and under the interface (" .. tostring(ui_order) .. ")")
+local art = sg:FindFirstChild("LobbyArt")
+check(art ~= nil and art.ClassName == "ImageLabel", "it holds the lobby's picture")
+check(art.Image == TitleScreen.LOBBY_ART, "... the same picture the title asks for")
+check(art.BackgroundTransparency == 0 and art.ImageTransparency == 0, "... opaque: nothing of the map shows through, even before the picture is made")
+check(art.Size.X.Scale == 1 and art.Size.Y.Scale == 1 and art.ScaleType == Enum.ScaleType.Crop, "... over the whole screen")
+-- (the picture is this game's drawing: UI/ArtSweep knows the name)
+local OwnArt = require("../src/shared/Assets/OwnArt")
+check(OwnArt.key_for(art.Image) == "lobby/bg", "UI/ArtSweep has a drawing for the cover's picture")
+check(BootCover.show(pg) == sg, "asked for twice, it is the same cover")
+local n = 0
+for _, c in pg:GetChildren() do
+	if c.Name == "CoberturaInicial" then
+		n += 1
+	end
+end
+check(n == 1, "... and only one is on screen")
+
+BootCover.lift(0)
+check(not BootCover.up() and sg.Parent == nil, "lifted, it is gone")
+BootCover.lift(0) -- (a second lift does nothing)
+check(not BootCover.up(), "lifting twice is harmless")
+
+-- with no word from the interface the cover goes by itself
+local sg2 = BootCover.show(pg)
+check(BootCover.up() and sg2 ~= sg, "a new cover can be shown")
+H.flush()
+H.flush()
+check(not BootCover.up() and sg2.Parent == nil, "left alone, the cover takes itself away (its time limit)")
+-- an old cover's time limit never takes a newer cover
+local a = BootCover.show(pg)
+BootCover.lift(0)
+local b = BootCover.show(pg)
+local later = H.later
+H.later = {}
+later[1][1](table.unpack(later[1], 2)) -- the first cover's limit runs now
+check(BootCover.up() and b.Parent == pg and a.Parent == nil, "an older cover's time limit leaves the newer cover alone")
+BootCover.lift(0)
+
+-- client/Main: the cover goes up before the map is made, and comes down after the interface is built
+local main = fs.readFile("src/client/Main.luau")
+local i_show = string.find(main, "BootCover.show", 1, true)
+local i_map = string.find(main, "pcall(WorldView.new)", 1, true)
+local i_ui = string.find(main, "pcall(UIRoot.new)", 1, true)
+local i_lift = string.find(main, "BootCover.lift", 1, true)
+check(i_show ~= nil and i_map ~= nil and i_show < i_map, "Main shows the cover before it makes the map")
+check(i_lift ~= nil and i_ui ~= nil and i_lift > i_ui, "Main lifts it only after the interface is built")
+
+print(string.format("cobertura_inicial: %d checks, %d failed", checks, failed))
+if failed > 0 then
+	error("cobertura_inicial failed")
+end
diff -ruN '--exclude=.git' '--exclude=*.rbxl' '--exclude=mudancas-sobre-o-roworld.patch' '--exclude=GUIA.md' '--exclude=SONS.md' '--exclude=out' '--exclude=build' '--exclude=.DS_Store' '--exclude=ArsenalIcon_*.luau' '--exclude=OwnArtData.luau' '--exclude=World.luau' '--exclude=EarthWorld.luau' '--exclude=MapData' '--exclude=*.png' '--exclude=*.svg' '--exclude=*.glb' '--exclude=__pycache__' '--exclude=telas' rw/tests/codes.luau cm/tests/codes.luau
--- rw/tests/codes.luau	1970-01-01 00:00:00.000000000 +0000
+++ cm/tests/codes.luau	2026-11-12 11:51:14.779617017 +0000
@@ -0,0 +1,162 @@
+--!nocheck
+-- Redeem codes: server/Codes reads the owner's list (server/MyCodes) and the text a player typed;
+-- server/Purchases.redeem_code pays a code once per player.   lune run tests/codes.luau
+require("./prelude")
+local Codes = require("../src/server/Codes")
+local MyCodes = require("../src/server/MyCodes")
+local Purchases = require("../src/server/Purchases")
+local Protocol = require("../src/shared/Net/Protocol")
+
+local fails, checks = 0, 0
+local function ok(cond: any, what: string)
+	checks += 1
+	if not cond then
+		fails += 1
+		print("FAIL " .. what)
+	end
+end
+
+-- 1. what a typed text stands for
+ok(Codes.normalize("bemvindo") == "BEMVINDO", "lower case is the same code")
+ok(Codes.normalize("  Bem-Vindo_2 ") == "BEM-VINDO_2", "spaces around go; - and _ stay")
+ok(Codes.normalize("BEM VINDO") == "BEMVINDO", "a space inside goes")
+ok(Codes.normalize("ab") == nil, "two characters are not a code")
+ok(Codes.normalize(string.rep("A", 25)) == nil, "25 characters are not a code")
+ok(Codes.normalize(string.rep("A", 24)) ~= nil, "24 characters are")
+ok(Codes.normalize("OLÁ123") == nil, "an accent is not a code")
+ok(Codes.normalize("A;B=C") == nil, "punctuation is not a code")
+ok(Codes.normalize(123) == nil and Codes.normalize(nil) == nil, "only text")
+ok(Codes.normalize(string.rep(" ", 80) .. "ABC") == nil, "a text longer than the limit is not read")
+
+-- 2. dates
+ok(Codes.day_end("1970-01-01") == 86399, "the first day ends at 86399")
+ok(Codes.day_end("2027-01-31") == 1801439999, "2027-01-31 ends at 1801439999")
+ok(Codes.day_end("2024-02-29") == 1709251199, "a leap day")
+ok(Codes.day_end("2027-13-01") == nil and Codes.day_end("31/01/2027") == nil, "not a date")
+
+-- 3. the list
+local LIST = {
+	["BEMVINDO"] = { coroas = 5000 },
+	["velho"] = { coroas = 100, expira = "2026-01-31" },
+	["FUTURO"] = { coroas = 250, expira = "2030-12-31" },
+	["DESLIGADO"] = { coroas = 100, ativo = false },
+	["x"] = { coroas = 100 },
+	["SEMVALOR"] = {},
+	["NEGATIVO"] = { coroas = -5 },
+	["QUEBRADO"] = { coroas = 1.5 },
+	["DATA"] = { coroas = 5, expira = "amanhã" },
+}
+local NOW = 1794268800 -- 2026-11-10
+local e, why = Codes.find("bemvindo", NOW, LIST)
+ok(e ~= nil and e.code == "BEMVINDO" and e.stars == 5000 and why == nil, "a good code is found, whatever its case")
+e, why = Codes.find("VELHO", NOW, LIST)
+ok(e == nil and why == "expired", "a code past its last day has expired")
+e = Codes.find("VELHO", Codes.day_end("2026-01-31"), LIST)
+ok(e ~= nil and e.stars == 100, "and is good until its last day's last second")
+e = Codes.find("futuro", NOW, LIST)
+ok(e ~= nil and e.stars == 250, "a code with a later date is good")
+e, why = Codes.find("DESLIGADO", NOW, LIST)
+ok(e == nil and why == "invalid", "a switched-off code reads as one that does not exist")
+for _, bad in { "NADA", "SEMVALOR", "NEGATIVO", "QUEBRADO", "DATA", "x", "", "  " } do
+	e, why = Codes.find(bad, NOW, LIST)
+	ok(e == nil and why == "invalid", "'" .. bad .. "' is not a code")
+end
+ok(#Codes.all(LIST) == 4, "four entries of the list are valid (" .. #Codes.all(LIST) .. ")")
+ok(#Codes.problems(LIST) == 5, "and five are reported (" .. #Codes.problems(LIST) .. ")")
+ok(#Codes.problems({ ["ABC"] = { coroas = 1 }, ["abc"] = { coroas = 2 } }) == 1, "the same code twice is reported")
+
+-- 4. the list the game ships with is fine
+ok(#Codes.problems(MyCodes) == 0, "server/MyCodes has no bad line: " .. table.concat(Codes.problems(MyCodes), "; "))
+ok(#Codes.problems() == 0, "and it is the list read by default")
+for _, entry in Codes.all() do
+	ok(entry.stars <= 1000000, entry.code .. " gives a sane amount")
+end
+
+-- 5. redeeming: once per player, written with the Stars in one write
+local rows = {}
+local down = false
+local store = {}
+function store:UpdateAsync(k, fn)
+	if down then
+		error("DataStore request was throttled")
+	end
+	local new = fn(rows[k])
+	if new ~= nil then
+		rows[k] = new
+	end
+	return new
+end
+function store:GetAsync(k)
+	if down then
+		error("DataStore unavailable")
+	end
+	return rows[k]
+end
+local P = { UserId = 42, Name = "Ana" }
+local Q = { UserId = 43, Name = "Beto" }
+local now = NOW
+local told = 0
+Purchases.reset()
+Purchases.configure({
+	datastore = store,
+	codes = LIST,
+	now = function()
+		return now
+	end,
+	players = {
+		GetPlayerByUserId = function(_, id)
+			return if id == 42 then P elseif id == 43 then Q else nil
+		end,
+	},
+	notify = function()
+		told += 1
+	end,
+})
+Purchases.load(P)
+Purchases.load(Q)
+local before = Purchases.inventory(P).stars
+told = 0
+local good, reason, paid, balance = Purchases.redeem_code(P, " bemvindo ")
+ok(good == true and reason == nil and paid == 5000, "a good code pays its Coroas")
+ok(balance == before + 5000 and Purchases.inventory(P).stars == before + 5000, "the balance follows")
+ok(told >= 1, "and the client is told")
+ok(rows.u42 ~= nil and rows.u42.codes.BEMVINDO == true and rows.u42.stars == before + 5000, "one write: the code and the Coroas")
+good, reason = Purchases.redeem_code(P, "BEMVINDO")
+ok(good == false and reason == "used", "the same player can't use it twice")
+ok(Purchases.inventory(P).stars == before + 5000, "and is not paid twice")
+good, reason, paid = Purchases.redeem_code(Q, "BemVindo")
+ok(good == true and paid == 5000, "another player can use it")
+good, reason = Purchases.redeem_code(P, "VELHO")
+ok(good == false and reason == "expired", "an expired code pays nothing")
+good, reason = Purchases.redeem_code(P, "NADA")
+ok(good == false and reason == "invalid", "an unknown code pays nothing")
+good, reason = Purchases.redeem_code(P, "DESLIGADO")
+ok(good == false and reason == "invalid", "a switched-off code pays nothing")
+ok(Purchases.inventory(P).stars == before + 5000, "the balance did not move")
+down = true
+good, reason = Purchases.redeem_code(P, "FUTURO")
