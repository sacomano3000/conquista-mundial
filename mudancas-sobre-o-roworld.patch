-MAPLIST = os.path.join(ROOT, "src", "shared", "Data", "MapList.luau")
-DATA_DIRS = [os.path.join(ROOT, "src", "server", "MapData"), os.path.join(ROOT, "src", "shared", "Data", "Maps")]
