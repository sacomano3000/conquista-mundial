-def unit_grid(name):
-    rows = UNITS[name]
-    w = len(rows[0])
-    assert all(len(r) == w for r in rows), name
-    h = len(rows)
-    grid = [["."] * UNIT for _ in range(UNIT)]
-    y0, x0 = (UNIT - h) // 2, (UNIT - w) // 2
-    for y, r in enumerate(rows):
-        for x, ch in enumerate(r):
-            grid[y0 + y][x0 + x] = ch
-    return grid
