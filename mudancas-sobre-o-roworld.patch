+-- --- windows over everything (the Arsenal, the Coleção, the shop, the menus) -----------------------
+-- A press must never reach what is behind an open window (a player with the Arsenal open pressed
+-- inside it and a match started: the press went to the title's button underneath). Two guards:
+--   W.add_blocker   an invisible button filling the window, under its own parts: Roblox gives a press
+--                   to the topmost button, so nothing behind gets it;
+--   W.guard_presses the kit's own buttons refuse a press while a window drawn above them is open,
+--                   whatever Roblox did with the click.
+
+--- nil, or a function saying whether a press on `button` must be ignored (W.guard_presses sets it).
+W.press_blocked = nil :: ((any) -> boolean)?
+
+--- An invisible button filling `c` (a full-screen window), under everything else in it.
+function W.add_blocker(c: any)
+	local g = c.gui
+	if g == nil or g:FindFirstChild("ClickBlocker") ~= nil then
+		return
+	end
+	local b = Instance.new("TextButton")
+	b.Name = "ClickBlocker"
+	b.Text = ""
+	b.BackgroundTransparency = 1
+	b.BorderSizePixel = 0
+	b.AutoButtonColor = false
+	b.Selectable = false
+	b.Size = UDim2.fromScale(1, 1)
+	b.ZIndex = -1000
+	b.Parent = g
+end
+
+--- Where `c`'s branch stands among `root`'s children (drawn later = larger), nil outside `root`.
+local function draw_rank(root: any, c: any): number?
+	local top = c
+	while top ~= nil and top.parent ~= root do
+		top = top.parent
+	end
+	if top == nil then
+		return nil
+	end
+	local i = table.find(root.children, top)
+	if i == nil then
+		return nil
+	end
+	local z = 1
+	pcall(function()
+		z = top.gui.ZIndex
+	end)
+	return z * 100000 + i
+end
+
+--- From now on a kit button under an open window does nothing when pressed. `windows()` lists the
+--- full-screen windows (each with `is_open`); the one drawn last among the open ones is the limit:
+--- a button drawn before it is behind it.
+function W.guard_presses(root: any, windows: () -> { any })
+	W.press_blocked = function(button: any): boolean
+		local limit: number? = nil
+		for _, w in windows() do
+			if w ~= nil and w.is_open == true and w.visible ~= false then
+				local r = draw_rank(root, w)
+				if r ~= nil and (limit == nil or r > limit) then
+					limit = r
+				end
+			end
+		end
+		if limit == nil then
+			return false
+		end
+		local mine = draw_rank(root, button)
+		return mine ~= nil and mine < limit
+	end
+end
