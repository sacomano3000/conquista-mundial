-    Rb = px * (0.16 + 0.24 * grow)
-    rise = px * 0.06 * max(0.0, t - 0.35)
-    fade = 1.0 if t < 0.72 else max(0.0, 1 - (t - 0.72) / 0.34)
-    puffs = []
-    k = 9
-    for i in range(k):
